{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medre.dev/schemas/matrix-embedded-metadata.schema.json",
  "title": "MEDRE Matrix embedded provenance",
  "type": "object",
  "required": [
    "envelope"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "type": "object",
      "required": [
        "schema_version",
        "canonical_event_id",
        "source_transport_id",
        "metadata_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "canonical_event_id": {
          "type": "string"
        },
        "source_transport_id": {
          "type": "string"
        },
        "source_adapter": {
          "type": "string"
        },
        "source_channel": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "relation_info": {
          "type": "string"
        },
        "lineage_pointer": {
          "type": "string"
        },
        "native_source_summary": {
          "type": "string"
        },
        "event_kind": {
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "metadata_mode": {
          "enum": [
            "minimal",
            "safe",
            "full"
          ]
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "root_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_native_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "adapter",
                "native_channel_id",
                "native_message_id",
                "native_thread_id"
              ],
              "additionalProperties": false,
              "properties": {
                "adapter": {
                  "type": "string"
                },
                "native_message_id": {
                  "type": "string"
                },
                "native_channel_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "native_thread_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "bridge_context": {
          "$ref": "#/$defs/BridgeContext"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "envelope": {
            "properties": {
              "metadata_mode": {
                "const": "minimal"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "metadata": false,
          "envelope": {
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "const": 1
              },
              "canonical_event_id": {
                "type": "string"
              },
              "source_transport_id": {
                "type": "string"
              },
              "metadata_mode": {
                "enum": [
                  "minimal",
                  "safe",
                  "full"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "envelope": {
            "properties": {
              "metadata_mode": {
                "const": "safe"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "transport": {
                "type": "object"
              },
              "routing": {
                "type": "object"
              },
              "radio": {
                "type": "object"
              },
              "telemetry": {
                "type": "object"
              },
              "bridge_context": {
                "$ref": "#/$defs/BridgeContext"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "BridgeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "relations"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/BridgeSource"
        },
        "relations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/BridgeRelation"
          }
        }
      }
    },
    "BridgeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "canonical_event_id",
        "channel",
        "sender_id",
        "native_ref"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "platform": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "canonical_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "sender_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "sender_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "sender_short_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "sender_verification": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "origin_label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "native_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/BridgeNativeRef"
            }
          ]
        }
      }
    },
    "BridgeRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_type",
        "target_event_id",
        "target_native_ref",
        "key"
      ],
      "properties": {
        "relation_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "target_event_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "target_native_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/BridgeNativeRef"
            }
          ]
        }
      }
    },
    "BridgeNativeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "native_channel_id",
        "native_message_id",
        "native_thread_id"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "native_channel_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "native_message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "native_thread_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    }
  }
}
