{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matrix durable batch checkpoint metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "abandoned_rooms"],
  "properties": {
    "schema_version": {"const": 1},
    "abandoned_rooms": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    }
  }
}
