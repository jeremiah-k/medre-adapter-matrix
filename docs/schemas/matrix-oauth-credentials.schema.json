{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed Matrix OAuth credentials",
  "description": "Private credential sidecar. Runtime validation additionally checks issuer origins, exact device scopes, and expiry ordering. Never commit populated credentials.",
  "type": "object",
  "required": [
    "auth_type",
    "homeserver",
    "user_id",
    "device_id",
    "access_token",
    "oauth"
  ],
  "properties": {
    "auth_type": {
      "const": "oauth"
    },
    "homeserver": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^https://"
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "access_token": {
      "type": "string",
      "minLength": 1,
      "writeOnly": true
    },
    "oauth": {
      "type": "object",
      "required": [
        "version",
        "issuer",
        "token_endpoint",
        "revocation_endpoint",
        "client_id",
        "scope",
        "expires_at",
        "refresh_at",
        "refresh_token"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://"
        },
        "token_endpoint": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://"
        },
        "revocation_endpoint": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://"
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "refresh_at": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "refresh_token": {
          "type": "string",
          "minLength": 1,
          "writeOnly": true
        }
      }
    }
  }
}
